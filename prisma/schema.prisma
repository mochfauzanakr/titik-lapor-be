generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model kategoriLaporan {
  id           BigInt    @id @default(autoincrement())
  namaKategori String    @map("nama_kategori") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  laporan      laporan[]

  @@map("kategori_laporan")
}

model laporan {
  id               String          @id @default(uuid())
  nomorResi        String?         @unique @map("nomor_resi") @db.VarChar(255)
  userId           String          @map("user_id")
  kategoriId       BigInt          @map("kategori_id")
  judul            String
  deskripsi        String?         @db.Text
  lat              Float
  lng              Float
  alamat           String?         @db.Text
  mediaUrls        Json            @map("media_urls") // Diubah ke Json karena MySQL tidak support Array
  status           status_laporan  @default(pending)
  createdAt        DateTime        @default(now()) @map("created_at")
  
  comments         comments[]
  kategori_laporan kategoriLaporan @relation(fields: [kategoriId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tanggapan        tanggapan[]

  @@map("laporan")
}

model tanggapan {
  id            BigInt     @id @default(autoincrement())
  petugasId     String     @map("petugas_id")
  isi_tanggapan String     @db.Text
  mediaUrls     Json       @map("media_urls")
  createdAt     DateTime   @default(now()) @map("created_at")
  laporanId     String     @map("laporan_id")
  
  laporan       laporan    @relation(fields: [laporanId], references: [id], onDelete: Cascade)
  users         users      @relation(fields: [petugasId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments      comments[]

  @@map("tanggapan")
}

model users {
  id          String      @id @default(uuid()) @map("uuid")
  username    String      @db.VarChar(255)
  email       String      @unique @db.VarChar(255)
  phoneNumber String      @unique @default("") @map("p_number") @db.VarChar(255)
  role        roles       @default(user)
  password    String      @db.VarChar(255)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  
  comments    comments[]
  laporan     laporan[]
  tanggapan   tanggapan[]

  @@map("users")
}

model comments {
  id          BigInt     @id @default(autoincrement())
  laporanId   String     @map("laporan_id")
  tanggapanId BigInt?    @map("tanggapan_id")
  userId      String     @map("user_id")
  body        String     @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  
  tanggapan   tanggapan? @relation(fields: [tanggapanId], references: [id], onDelete: Cascade, map: "comments_tanggapan_id_fkey")
  laporan     laporan    @relation(fields: [laporanId], references: [id], onDelete: Cascade, map: "comments_laporan_id_fkey")
  users       users      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "comments_user_id_fkey")

  @@map("comments")
}

enum roles {
  user
  petugas
  admin
}

enum status_laporan {
  pending
  diproses
  selesai
  ditolak
}